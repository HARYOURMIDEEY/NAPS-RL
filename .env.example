# Copy to .env for local development. On Vercel, add these in
# Project -> Settings -> Environment Variables. Never commit real values.

# --- Database (PostgreSQL) -------------------------------------------------
# For no-terminal first deploy on Vercel, set AUTO_DB_SETUP=true temporarily.
# The build script creates tables and seeds the initial Super Admin, then turn it off.
AUTO_DB_SETUP="false"
# Use the POOLED connection string here (Neon / Supabase / Vercel Postgres).
DATABASE_URL="postgresql://user:password@host:5432/naps_elearning?sslmode=require"
# Direct (non-pooled) connection string, used only by `prisma db push`.
# If your provider has no separate pooler, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://user:password@host:5432/naps_elearning?sslmode=require"

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# --- Public URL ------------------------------------------------------------
# Optional on Vercel (falls back to the Vercel production URL). Set it once you
# attach a custom domain, e.g. https://elearning.naps-futminna.org
APP_URL=""

# --- Email (verification codes + password reset) -----------------------------
# Any SMTP provider: Resend, Brevo, Postmark, SendGrid, Gmail app password...
EMAIL_SERVER="smtp://user:pass@smtp.provider.com:587"
EMAIL_FROM="NAPS E-Learning <no-reply@yourdomain.com>"

# --- AI tutor (server-side only) ---------------------------------------------
AI_API_KEY=""
# Optional. Defaults to claude-sonnet-5-5. Use claude-haiku-5-5 for lower cost.
AI_MODEL=""

# --- File storage (Vercel Blob) ----------------------------------------------
# Vercel dashboard -> Storage -> Create Blob store -> connect to this project.
# Vercel then injects this automatically. Locally, run `vercel env pull`.
BLOB_READ_WRITE_TOKEN=""

# --- Rate limiting (optional but recommended in production) --------------------
# Free Upstash Redis database -> REST API credentials. Without these, a weaker
# per-instance in-memory limiter is used.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Seeding (only when running `npm run db:seed`) -----------------------------
INITIAL_SUPER_ADMIN_PASSWORD=""
# Set to "true" to also create demo questions, a quiz, an exam and an announcement.
SEED_SAMPLE_DATA=""
